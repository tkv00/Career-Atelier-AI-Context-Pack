# Supabase 로컬 config.toml이 env()로 참조하는 값. supabase/.env로 복사해 채운다.
#
# 이 파일들은 각자 자기 배포본에 맞는 값이라 리포에 커밋하지 않는다.

# 배포한 웹 앱 주소. 인증 메일의 리다이렉트 허용 목록에 쓰인다.
SITE_URL=https://your-project.vercel.app
SITE_REDIRECT_URL=https://your-project.vercel.app/**

# 러너 로그인 코드·비밀번호 재설정 메일 발송용 SMTP (Resend, 선택).
# 안 쓰면 Supabase 기본 메일러가 대신 쓰이는데, 시간당 2통으로 제한돼 있어
# 가입 흐름을 반복 테스트하면 금방 막힌다. resend.com에서 무료로 발급받는다.
RESEND_API_KEY=your-resend-api-key
RESEND_ADMIN_EMAIL=noreply@your-domain.example
