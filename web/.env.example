# Career Atelier v2 — web/ (Vercel) 환경변수
#
# 이 파일에 나열된 두 개만 Vercel 환경변수에 들어간다.
# service_role 키는 절대 여기에 두지 않는다 (docs/DESIGN-V2-CLOUD.md §3, §19.2 #2).
# 러너 자격증명, OpenAI/Anthropic API 키도 여기 존재하면 안 된다 — 애초에 web/는
# LLM을 호출하는 코드를 갖지 않는다.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 허용된 이메일 1개만 로그인 가능하게 하는 방어 계층 (§6 3층의 보조).
# 실제 강제는 Supabase Auth 설정(가입 비활성화)과 RLS(§5)가 하고,
# 이 값은 로그인 폼에서 사용자 실수를 조기에 막는 UX 보조일 뿐이다.
NEXT_PUBLIC_ALLOWED_EMAIL=you@example.com
